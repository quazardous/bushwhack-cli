{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "chrome",
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "customConditions": [
      "bushwhack-src"
    ]
  },
  "include": [
    "src",
    "build.ts",
    "chromium.ts",
    "dev.ts",
    "dev-control.ts"
  ]
}
