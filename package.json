{
  "name": "bushwhack",
  "version": "0.3.0",
  "description": "Let a web-chat model (Meta AI, Gemini, ChatGPT) work on a project folder on your machine, through a browser extension and a local service — you approve every change.",
  "license": "MIT",
  "author": "David Berlioz",
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ext:build": "node --conditions=bushwhack-src --import tsx extension/build.ts",
    "ext:watch": "node --conditions=bushwhack-src --import tsx extension/build.ts --watch",
    "chromium": "node --conditions=bushwhack-src --import tsx extension/chromium.ts",
    "ext:dev": "node --conditions=bushwhack-src --import tsx extension/dev.ts",
    "ext:icons": "node --conditions=bushwhack-src --import tsx extension/icons/gen-icons.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "modern-screenshot": "^4.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quazardous/bushwhack-cli.git"
  },
  "homepage": "https://github.com/quazardous/bushwhack-cli",
  "bugs": {
    "url": "https://github.com/quazardous/bushwhack-cli/issues"
  },
  "keywords": [
    "llm",
    "chat",
    "browser-extension",
    "meta-ai",
    "gemini",
    "chatgpt",
    "developer-tools",
    "tool-calling"
  ]
}
